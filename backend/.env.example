# Configuración del Servidor
PORT=3001
JWT_SECRET=tu_secreto_super_seguro

# Base de Datos PostgreSQL
DATABASE_URL=postgres://usuario:password@localhost:5432/facturas

# IA - Google Gemini
GEMINI_API_KEY=tu_api_key_de_google_gemini

# Telegram Bot
TELEGRAM_BOT_TOKEN=tu_token_de_telegram_bot

# Email (Monitorización y Alertas)
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password_de_google
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993

# Opcional: SMTP si es distinto al host de IMAP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
